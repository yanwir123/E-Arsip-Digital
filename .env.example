# ================= Aplikasi =================
APP_NAME="E-Arsip"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# ================= Database =================
# Cara 1 (disarankan): satu URL koneksi.
#   Format: mysql://user:pass@host:port/nama_db
#   (prefix driver "mysql+pymysql" juga dikenali)
DATABASE_URL=mysql://root:password@127.0.0.1:3306/E-Arsip

# Cara 2: variabel terpisah (dipakai bila DATABASE_URL kosong).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=E-Arsip
DB_USER=root
DB_PASS=

# ================= Keamanan =================
# Kunci acak untuk HMAC token CSRF. WAJIB diisi string acak minimal 32 karakter.
# Aplikasi menolak berjalan bila masih placeholder/terlalu pendek.
# Buat dengan:  php -r "echo bin2hex(random_bytes(32));"
APP_KEY=ubah-kunci-ini-menjadi-acak-panjang

# Batas ukuran file upload arsip (dalam byte). 10 MB = 10485760
UPLOAD_MAX_SIZE=10485760

# ================= Rate limit login =================
# Maksimum percobaan login gagal (per-IP DAN per-akun) sebelum dikunci sementara.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# ================= Kebijakan password =================
# Panjang minimum password (huruf + angka wajib, password umum ditolak).
PASSWORD_MIN_LENGTH=8

# ================= Rate limit OTP =================
# Batas pengiriman/ kirim-ulang kode OTP.
OTP_SEND_MAX_PER_EMAIL=5
OTP_SEND_MAX_PER_IP=10
OTP_SEND_COOLDOWN_SECONDS=60

# ================= Proxy tepercaya =================
# Isi HANYA bila aplikasi berada di belakang reverse-proxy/load balancer yang
# Anda percayai (mis. 127.0.0.1,10.0.0.0/8 -> sebutkan IP persisnya, dipisah koma).
# Kosong = header X-Forwarded-For DIABAIKAN (aman untuk deployment langsung).
TRUSTED_PROXIES=

# ================= Cloudflare Turnstile =================
# Isi kedua nilai ini dari Cloudflare Dashboard > Turnstile.
# Kosong = Turnstile nonaktif untuk development/local.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ================= SMTP (Email) =================
# MAIL_DRIVER: smtp (kirim asli) | mail | log (simpan ke storage/logs/mail.log untuk uji)
MAIL_DRIVER=log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contoh@gmail.com
SMTP_PASS=apppassword
SMTP_FROM_NAME="E-Arsip"

# ================= JWT & AUTH =================
# Kunci penandatangan token JWT (verifikasi email). WAJIB string acak minimal 32 karakter.
# Aplikasi menolak berjalan bila masih placeholder/terlalu pendek.
# Buat dengan:  php -r "echo bin2hex(random_bytes(32));"
SECRET_KEY=ubah-jadi-string-acak-panjang-minimal-32-karakter
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ================= OTP =================
OTP_EXPIRY_SECONDS=600
OTP_MAX_ATTEMPTS=5

# ================= Validasi & Sanksi =================
# Arsip berstatus "pending" dihapus otomatis jika belum divalidasi (jam).
PENDING_AUTO_DELETE_HOURS=24

# Durasi ban sementara per tingkat pelanggaran kode etik (hari).
# 0 = permanen sampai dibuka manual oleh admin/developer.
PENALTY_BASIC_DAYS=1
PENALTY_SEDANG_DAYS=7
PENALTY_BERAT_DAYS=30
